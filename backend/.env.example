# Puerto donde escucha el backend.
PORT=3000

# Secreto usado para cifrar las credenciales de SQL Server guardadas en
# backend/data/bd.config. Debe tener al menos 32 caracteres y ser el mismo
# en cada arranque del backend (si cambia, ya no se podrá leer lo guardado).
CONFIG_SECRET=cambia-esto-por-un-secreto-largo-y-unico

# Credenciales de SQL Server. El backend las lee de aquí al arrancar y las
# guarda cifradas (con CONFIG_SECRET) en backend/data/bd.config — ya no se
# configuran desde la app. Si cambias alguna, basta con reiniciar el
# backend para que tome el valor nuevo.
DB_SERVIDOR=
DB_BASE_DATOS=
DB_USUARIO=
DB_CONTRASENA=
